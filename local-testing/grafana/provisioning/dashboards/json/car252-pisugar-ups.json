            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "—",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": null,
                "to": 0,
                "result": {
                  "text": "—",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 72,
                "to": null,
                "result": {
                  "text": "> 3 days",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "EMPTY"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Time to empty"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "FULL"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Time to full"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "RATE"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Charge rate"
              },
              {
                "id": "unit",
                "value": "suffix:%/h"
              },
              {
                "id": "mappings",
                "value": []
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
