      },
      {
        "name": "raceid",
        "label": "Race",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "wotl-postgres"
        },
        "definition": "SELECT \"__value\", \"__text\" FROM (SELECT race_id AS \"__value\", name || ' (' || to_char(race_time, 'MM/DD/YY') || ')' AS \"__text\", race_time FROM races UNION ALL SELECT '', 'None', NULL WHERE NOT EXISTS (SELECT 1 FROM races)) AS opts ORDER BY race_time DESC",
        "query": {
          "format": "table",
          "rawSql": "SELECT \"__value\", \"__text\" FROM (SELECT race_id AS \"__value\", name || ' (' || to_char(race_time, 'MM/DD/YY') || ')' AS \"__text\", race_time FROM races UNION ALL SELECT '', 'None', NULL WHERE NOT EXISTS (SELECT 1 FROM races)) AS opts ORDER BY race_time DESC"
        },
        "refresh": 2,
        "sort": 0,
        "current": {},
        "options": []
      },
      {
        "name": "race_from",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "wotl-postgres"
        },
        "definition": "SELECT coalesce(max((extract(epoch from race_time) * 1000)::bigint), 0)::text AS \"__value\" FROM races WHERE race_id = ${raceid:sqlstring}",
        "query": {
          "format": "table",
          "rawSql": "SELECT coalesce(max((extract(epoch from race_time) * 1000)::bigint), 0)::text AS \"__value\" FROM races WHERE race_id = ${raceid:sqlstring}"
        },
        "refresh": 2,
        "sort": 0,
        "current": {},
        "options": []
      },
      {
        "name": "race_to",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "wotl-postgres"
        },
        "definition": "SELECT coalesce((SELECT CASE WHEN end_time IS NULL OR end_time + interval '1 hour' > now() THEN 'now' ELSE (extract(epoch from end_time) * 1000 + 3600000)::bigint::text END FROM races WHERE race_id = ${raceid:sqlstring}), 'now') AS \"__value\"",
        "query": {
          "format": "table",
          "rawSql": "SELECT coalesce((SELECT CASE WHEN end_time IS NULL OR end_time + interval '1 hour' > now() THEN 'now' ELSE (extract(epoch from end_time) * 1000 + 3600000)::bigint::text END FROM races WHERE race_id = ${raceid:sqlstring}), 'now') AS \"__value\""
        },
        "refresh": 2,
        "sort": 0,
        "current": {},
        "options": []
      }
    ]
