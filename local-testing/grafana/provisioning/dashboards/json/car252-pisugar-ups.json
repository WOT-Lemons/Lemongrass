      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "wotl-pisugar-ql"
          },
          "refId": "SLOPE",
          "hide": true,
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT derivative(mean(\"value\"), 1h) FROM \"pisugar-battery-level\" WHERE (\"host\" =~ /^$host$/) AND $timeFilter GROUP BY time(5m) fill(none)"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "wotl-pisugar-ql"
          },
          "refId": "LEVEL",
          "hide": true,
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"value\") FROM \"pisugar-battery-level\" WHERE (\"host\" =~ /^$host$/) AND time > now() - 1m"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "AVG",
          "type": "reduce",
          "expression": "SLOPE",
          "reducer": "mean",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "NOW",
          "type": "reduce",
          "expression": "LEVEL",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "RATE",
          "type": "math",
          "expression": "$AVG + 0 * $NOW"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "EMPTY",
          "type": "math",
          "expression": "$NOW / -$RATE"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "FULL",
          "type": "math",
          "expression": "(100 - $NOW) / $RATE"
        }
      ],
      "timeFrom": "30m",
      "hideTimeOverride": true,
      "title": "Battery ETA",
      "type": "stat"
    },
