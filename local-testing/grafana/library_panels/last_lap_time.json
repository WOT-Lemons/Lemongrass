      "groupBy": [],
      "measurement": "lap",
      "orderByTime": "ASC",
      "policy": "default",
      "query": "SELECT \"lap_time\" FROM \"lap\" WHERE time >= ${race_from}ms AND \"race_id\" = '$raceid' AND \"car_number\" = '$carno'",
      "rawQuery": true,
      "refId": "A",
      "resultFormat": "time_series",
      "select": [
        [
          {
            "params": [
              "lap_time"
            ],
            "type": "field"
          }
        ]
      ],
      "tags": [
        {
          "key": "race_id",
          "operator": "=",
          "value": "$raceid"
        },
        {
          "condition": "AND",
          "key": "car_number",
          "operator": "=",
          "value": "$carno"
        }
      ]
    }
  ],
  "title": "Last Lap Time",
  "transparent": true,
  "type": "stat"
